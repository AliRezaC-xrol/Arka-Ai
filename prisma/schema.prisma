// Arka — Prisma schema (Phase 1: Google OAuth Authentication)
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  googleId      String    @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime  @default(now())
  isBanned      Boolean   @default(false)
  bannedAt      DateTime?
  bannedReason  String?
  timeoutUntil  DateTime?
  timeoutReason String?

  conversations Conversation[]
  providerKeys  UserProviderKey[]
  usageEvents   UsageEvent[]
  notifications Notification[]
  sessions      Session[]
  providers     Provider[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("admin_sessions")
}

model Provider {
  id               String            @id @default(uuid())
  scope            String // "global" (ادمین اضافه کرده، همه می‌بینن) | "user" (فقط خود کاربر)
  ownerUserId      String? // فقط برای scope=user
  name             String // اسمی که ادمین/کاربر می‌ذاره و روی سایت نشون داده می‌شه
  kind             String // openai | anthropic | google | openai_compatible | ...
  baseUrl          String?
  enabled          Boolean           @default(true)
  createdAt        DateTime          @default(now())
  keys             ProviderKey[]
  models           ProviderModel[]
  owner            User?             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  userProviderKeys UserProviderKey[]

  @@map("providers")
}

model ProviderKey {
  id            String    @id @default(uuid())
  providerId    String
  label         String
  ciphertext    Bytes
  iv            Bytes
  tag           Bytes
  status        String    @default("unknown") // ok | invalid | exhausted
  lastCheckedAt DateTime?
  priority      Int       @default(0) // ترتیب استفاده برای failover
  createdAt     DateTime  @default(now())
  provider      Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_keys")
}

model ProviderModel {
  id            String   @id @default(uuid())
  providerId    String
  modelId       String
  displayName   String
  supportsChat  Boolean  @default(true)
  supportsImage Boolean  @default(false)
  enabled       Boolean  @default(true)
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_models")
}

model UserProviderKey {
  // پروایدرهای شخصی کاربر (scope=user در Provider بالا مدیریت می‌شه، این فقط رفرنس سریع است)
  id         String   @id @default(uuid())
  userId     String
  providerId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("user_provider_keys")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  title     String
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // user | assistant
  content        String       @db.Text
  contentType    String       @default("text") // text | image | code
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model UsageEvent {
  id         String   @id @default(uuid())
  userId     String
  providerId String
  modelId    String
  tokensIn   Int
  tokensOut  Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_events")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String? // null یعنی برای همه (broadcast)
  broadcastId String? // گروه‌بندی پیام‌های همگانی برای حذف دسته‌جمعی
  title       String
  body        String
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
