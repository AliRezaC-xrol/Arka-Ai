# ==============================================================================
# Arka Environment Variables — Production Template
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://arka_user:your_secure_password@localhost:5432/arka?schema=public"

# Session JWT Secret (minimum 32 characters or random 32-byte hex)
SESSION_SECRET="change-this-to-a-secure-random-32-character-secret-in-production"

# BYOK Master Encryption Key (32-byte hex string for AES-256-GCM)
BYOK_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# App Public URL
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Admin Secret Password (for the admin panel route)
# Generate your own — do NOT ship the placeholder value to production.
ADMIN_PASSWORD="change-this-to-a-strong-unique-admin-password"

# Dev-only login shortcut (/api/auth/mock-login). Leave unset in production —
# the route returns 404 unless this is explicitly "true" outside dev.
# ALLOW_DEV_AUTH="false"
